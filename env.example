# Copy this file to .env and paste your team's keys after the = signs.
# .env stays on your computer. Never commit it, never paste it into a chat.

# Deepgram: speech-to-text and the read-back voice
DEEPGRAM_API_KEY=

# Google AI Studio: words -> invoice fields
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen

# Stripe TEST key only: it starts with sk_test_
STRIPE_SECRET_KEY=

# Optional fallback if there is no Gemini key
OPENAI_API_KEY=
